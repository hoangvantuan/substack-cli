{
  "name": "substackctl",
  "version": "0.1.1",
  "description": "Command-line tool that manages posts on Substack and reads other people's newsletters",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hoangvantuan/substack-cli.git"
  },
  "type": "module",
  "bin": {
    "substackctl": "dist/bin/substackctl.js"
  },
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist",
    "!dist/test"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build",
    "pretest": "npm run build",
    "test": "node --test \"dist/test/*.test.js\"",
    "test:integration": "npm run build && node --test --test-concurrency=1 \"dist/test/integration/*.test.js\""
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  }
}
